# Copy to .env and fill in. NEVER commit a real .env file.
# Every value below is a placeholder. Real values live in your secret manager /
# Cloud Run environment, not in this repository.

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/doordripp

# JWT signing secret. REQUIRED, no default exists. Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development
# Number of trusted reverse-proxy hops (Cloud Run / Nginx = 1). Needed for correct per-IP rate limits.
TRUST_PROXY=1

# ImageKit (cloud image storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Google OAuth
# Only tokens whose audience is one of these client IDs are accepted. Nothing is hardcoded.
#   GOOGLE_CLIENT_ID          Web client ID. The mobile app passes this as serverClientId,
#                             so it is the audience of Android (and iOS) ID tokens.
#   GOOGLE_APP_CLIENT_ID_1/2  Additional app client IDs, e.g. the iOS client ID.
#   GOOGLE_ACCEPTED_CLIENT_IDS  Optional comma-separated list of further client IDs.
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_APP_CLIENT_ID_1=your_ios_client_id.apps.googleusercontent.com
GOOGLE_APP_CLIENT_ID_2=
GOOGLE_ACCEPTED_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Sign in with Apple. REQUIRED in production (Apple sign-in is refused without it).
APPLE_BUNDLE_ID=com.example.app
# Optional: comma-separated list of additional accepted client/service IDs
# APPLE_ACCEPTED_CLIENT_IDS=

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Doordripp
CLIENT_URL=http://localhost:5173
SUPPORT_EMAIL=support@example.com

GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Minutes an unpaid online order may hold stock before it is failed and released (min 5).
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# Development only. Ignored when NODE_ENV=production.
RAZORPAY_TEST_MODE_SKIP_VERIFICATION=false
DISABLE_RATE_LIMIT=false

# Trial Room fee charged on Trial & Buy orders (server-side source of truth)
TRIAL_FEE=0

# Company details (printed on invoices)
COMPANY_NAME=Doordripp
COMPANY_GSTIN=
COMPANY_STATE_CODE=
COMPANY_EMAIL=support@example.com
COMPANY_PHONE=
COMPANY_ADDRESS_LINE1=
COMPANY_ADDRESS_LINE2=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_COUNTRY=India
COMPANY_PINCODE=

# OneSignal push notifications (staff app)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# OneSignal push notifications (customer app)
APP_ONESIGNAL_APP_ID=
APP_ONESIGNAL_REST_API_KEY=
