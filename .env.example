MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<db>?appName=Cluster0

# JWT Secret
# SECURITY: Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Server URLs for testing
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development

# ImageKit Configuration (Cloud Image Storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_APP_CLIENT_ID_1=your_google_app_client_id_1.apps.googleusercontent.com
GOOGLE_APP_CLIENT_ID_2=your_google_app_client_id_2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Apple Sign-In Configuration (iOS / Flutter)
# Bundle identifier for your iOS app (e.g., com.doordripp.app)
APPLE_BUNDLE_ID=com.doordripp.app
# Optional: comma-separated list of additional accepted client/service IDs
# APPLE_ACCEPTED_CLIENT_IDS=com.doordripp.app,com.doordripp.client

# Email Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=DoorDripp
CLIENT_URL=http://localhost:5173
SUPPORT_EMAIL=support@example.com

GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Test Mode
RAZORPAY_TEST_MODE_SKIP_VERIFICATION=false
DISABLE_RATE_LIMIT=false

# Company Details
COMPANY_NAME=DoorDripp
COMPANY_GSTIN=your_gstin
COMPANY_STATE_CODE=09
COMPANY_EMAIL=support@example.com
COMPANY_PHONE=+91-0000000000
COMPANY_ADDRESS_LINE1=Line 1
COMPANY_ADDRESS_LINE2=Line 2
COMPANY_CITY=City
COMPANY_STATE=State
COMPANY_COUNTRY=India
COMPANY_PINCODE=000000

# OneSignal Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
